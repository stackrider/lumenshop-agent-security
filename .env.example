# =====================================================================
# LumenShop — laboratório do episódio 003 (Joe Ships)
#
# Copie para .env:   cp .env.example .env
#
# O .env está no .gitignore e NUNCA deve ser commitado.
# Todos os valores abaixo são PLACEHOLDERS. Não existe nenhum segredo
# de verdade neste repositório, e não deve existir nunca.
# =====================================================================

# ---------- Portas do laboratório ----------
PORT_VULNERAVEL=3000
PORT_BLINDADO=3001
PORT_N8N=5678
# Mock da WhatsApp Cloud API + UI de conversa (estilo WhatsApp).
PORT_MOCK=8080

# Versão da imagem do n8n. Os workflows em workflows/ foram exportados
# no esquema de nós da linha 1.7x (nó AI Agent typeVersion 1.7).
# Versões mais novas migram na importação. Veja SETUP.md.
N8N_VERSION=latest

# ---------- Limites do modo blindado (§22 do roteiro) ----------
LIMIT_BODY_CHARS=2000
LIMIT_STEPS_PER_SESSION=12
LIMIT_CALLS_PER_MINUTE=20
LIMIT_DAILY_SPEND_BRL=5.00
COST_PER_CALL_BRL=0.02

# ---------- Para onde o n8n manda a resposta ----------
# No modo DEMO (padrão) aponta para o mock local: nada de Meta, nada de token.
# No modo REAL, troque por  https://graph.facebook.com  e preencha o token
# e o phone number id abaixo. Veja SETUP.md, caminho 3.
WHATSAPP_API_BASE=http://whatsapp-mock:8080
WHATSAPP_API_VERSION=v21.0

# ---------- WhatsApp Cloud API (Meta) ----------
# Só é necessário se você quiser rodar de verdade no WhatsApp.
# O laboratório inteiro funciona sem isso: a UI de conversa (o mock) já mostra
# o antes/depois como se fosse WhatsApp, sem conta na Meta.
#
# Onde pegar: https://developers.facebook.com/docs/whatsapp/cloud-api
# Use o NÚMERO DE TESTE que a Meta te dá. Nunca o número da sua empresa.
# No modo demo, estes placeholders bastam (o mock ignora o token).
WHATSAPP_TOKEN=token-ficticio-do-mock
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_VERIFY_TOKEN=lumenshop-verify-ficticio

# ---------- Modelo ----------
# A credencial do modelo é cadastrada DENTRO do n8n (Credentials),
# não neste arquivo. Está aqui só como lembrete do que você vai precisar.
# OPENAI_API_KEY=cadastre-no-n8n-em-Credentials-nao-aqui
